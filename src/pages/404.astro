---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found | Pocatello Asphalt Paving";
const description = "That page is not on the Pocatello Asphalt Paving site.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">That page is not here</h1>
      <p class="mt-4">Use the menu or go back to the homepage to request a paving estimate.</p>
      <a class="mt-6 inline-block font-semibold underline decoration-sun decoration-2 underline-offset-4" href="/">Pocatello asphalt paving</a>
    </div>
  </section>
</BaseLayout>
