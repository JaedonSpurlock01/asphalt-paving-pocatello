---
import { business } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Thank You | Pocatello Asphalt Paving";
const description = "Your paving estimate request is in. We will follow up during business hours.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">Thank you. Your estimate request is in.</h1>
      <p class="mt-5 text-lg">
        We have your name, phone, email, service, and project size. An estimator will reach out during business hours: Monday through Friday, 9 AM to 6 PM, and Saturday, 9 AM to 4 PM.
      </p>
      <p class="mt-4">
        If the job is time-sensitive, call <a class="tracking-phone font-bold underline decoration-sun decoration-2 underline-offset-4" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a> now.
      </p>
      <a class="mt-8 inline-block bg-carbon px-5 py-3 font-bold text-sun" href="/">Back to Pocatello asphalt paving</a>
    </div>
  </section>
</BaseLayout>
