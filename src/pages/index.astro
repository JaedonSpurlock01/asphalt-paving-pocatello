---
import { Image } from "astro:assets";
import siteAssets from "virtual:site-assets";
import Diagram from "../components/Diagram.astro";
import FaqList from "../components/FaqList.astro";
import InternalLinks from "../components/InternalLinks.astro";
import LeadForm from "../components/LeadForm.astro";
import Process from "../components/Process.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import WhyChoose from "../components/WhyChoose.astro";
import config from "virtual:site";
import { business, faqs, hours } from "../data/site";
import { faqPageSchema } from "../data/schema";
import BaseLayout from "../layouts/BaseLayout.astro";

const extraSchemas = [faqPageSchema(faqs)];
const heroBackground = siteAssets.hero;

const title = `${business.city} Paving Contractor | Driveways, Lots, Repair & Sealcoating`;
const description =
  `Local ${business.city} paving contractor for asphalt driveways, blacktop repair, pothole patching, parking lots, private roads, and sealcoating. Free estimates. Call ${business.phoneDisplay}.`;
---

<BaseLayout title={title} description={description} extraSchemas={extraSchemas}>
  <section class="relative isolate overflow-hidden text-linen">
    <Image
      src={heroBackground}
      alt=""
      width={heroBackground.width}
      height={heroBackground.height}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 -z-10 bg-carbon/30 backdrop-blur-sm" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-start gap-10 px-5 py-16 md:grid-cols-[1.2fr_0.8fr] md:py-24">
      <div>
        <p class="text-sm font-semibold tracking-[0.16em] text-sun uppercase">{business.name}</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-white md:text-5xl">
          {business.city} paving contractor for asphalt driveways, parking lots, and private roads
        </h1>
        <p class="prose-measure mt-5 text-lg text-alabaster">
          {business.name} handles residential driveways, commercial parking lots, and private lanes in {business.serviceAreaLabel}. We build new blacktop, resurface stable pavement, and repair potholes and failed sections.
        </p>
        <p class="prose-measure mt-5 text-lg text-alabaster">
          Get a free on-site estimate for hot-mix paving, crack sealing, patch repair, or sealcoating. Tell us the square footage and the service. We look at the ground before we give you a price.
        </p>
        <a class="tracking-phone mt-6 inline-block bg-sun px-5 py-3 font-bold text-carbon" href={`tel:${business.phoneTel}`}>
          Call {business.phoneDisplay}
        </a>
      </div>
      <div class="bg-linen p-5 text-carbon md:p-6" id="estimate">
        <h2 class="text-2xl font-bold">Request a free estimate</h2>
        <p class="mt-2 text-sm text-graphite">Share the project size and how to reach you. Quotes are free.</p>
        <div class="mt-4">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-carbon/10 bg-sun">
    <ul class="mx-auto grid max-w-6xl gap-4 px-5 py-5 text-sm font-semibold sm:grid-cols-3">
      <li>Licensed and insured</li>
      <li>Free on-site estimates</li>
      <li>Built for {config.market.climateLabel}</li>
    </ul>
  </section>

  <section class="bg-linen py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-3xl font-bold">A paving crew that says what the job includes</h2>
        <p class="prose-measure mt-4">
          <strong>{business.name}</strong> serves homeowners, property managers, and private-road owners. We pave with hot-mix asphalt, compacted base, and drainage planned for {business.serviceAreaLabel}.
        </p>
        <p class="prose-measure mt-4">
          We use professional paving equipment and proven placement and compaction practices. As a local asphalt contractor in {business.city}, we handle residential and commercial paving under one crew.
        </p>
        <p class="prose-measure mt-4">
        Our team understands that you have many options when choosing a paving contractor, so we want to assure you we are the best choice for your project. We will work diligently to complete your project on time and within budget. And we guarantee your complete satisfaction with our work.
        </p>
        <p class="prose-measure mt-4">
          <a class="font-semibold underline decoration-sun decoration-2 underline-offset-4" href="/about">Read how we work</a>
          or call <a class="tracking-phone font-semibold underline decoration-sun decoration-2 underline-offset-4" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>.
        </p>
      </div>
      <Diagram name="process" label="Four-step paving process from estimate to cleanup" />
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="text-3xl font-bold">Why property owners call us</h2>
      <p class="prose-measure mt-4 text-graphite">
        The right paving contractor will tell you when an overlay is a mistake. These are the standards we hold on every {business.city}{" "}
        {config.outboundLink ? (
          <a class="font-semibold underline decoration-sun decoration-2 underline-offset-4" href={config.outboundLink.href} target="_blank" rel="noopener noreferrer">{config.outboundLink.text}</a>
        ) : (
          "asphalt paving"
        )}{" "}
        project — residential, commercial, and private-road work.
      </p>
      <div class="mt-10">
        <WhyChoose />
      </div>
    </div>
  </section>

  <section class="bg-linen py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="text-3xl font-bold">Asphalt services</h2>
      <p class="prose-measure mt-4">
        Each service has its own page with the process, limits, and a way to ask for a free estimate. {business.city} asphalt paving starts with the surface you have — whether you need driveway paving, parking lot paving, pothole repair, crack sealing, or sealcoating.
      </p>
      <ServicesGrid />
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="text-3xl font-bold">How a project moves</h2>
      <p class="prose-measure mt-4 text-graphite">
        You always know the next step. Weather can move a pave day. It does not move the scope without a conversation. Our asphalt contractor crew follows the same path for hot-mix asphalt paving, asphalt patching, and seal coat jobs.
      </p>
      <div class="mt-10">
        <Process />
      </div>
    </div>
  </section>

  <section class="bg-alabaster py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-4">
        <h2 class="text-3xl font-bold">Paving built for {config.market.climateLabel}</h2>
        <p>
          {config.market.climateSummary} Asphalt paving in {business.city} must account for local exposure, traffic, and the way water moves across each property.
        </p>
        <p>
          Water is the real enemy. A driveway that slopes toward the garage, a lot that ponds at the storefront, or a lane with no shoulder will fail in the same place. We look at drainage before thickness. A thicker mat on a bad slope still traps water.
        </p>
        <p>
          The base is the structure you do not see. Soft, wet soil pumps under traffic and prints a web of cracks through whatever we pave on top. That is why some estimates include removal and aggregate, and some are overlays. An overlay is the right tool only when the existing pavement is stable, drained, and thick enough at the edges to accept another lift.
        </p>
        <h3 class="pt-4 text-2xl font-bold">What we need from you to price the work</h3>
        <p>
          Start with the approximate size in square feet. A 12-by-50 drive is 600 square feet. A small shop lot may be several thousand. Measure the flared apron too, because it takes turning traffic and meets the city street.
        </p>
        <p>
          Tell us the service: asphalt driveway paving, blacktop replacement, parking lot repair, private road paving, pothole repair, crack fill, asphalt sealcoating (seal coat), or a mix you can describe as Other. Add a phone number and an email. We use those to schedule the free walkthrough, not to send a generic blast.
        </p>
        <ul class="list-disc space-y-2 pl-5">
          <li>Square footage, including aprons and turnarounds</li>
          <li>What uses the pavement: cars, delivery trucks, trailers, or foot traffic</li>
          <li>Whether water sits on the surface after a storm or during melt</li>
          <li>Access limits: alley width, overhead lines, or a hill the paver must climb</li>
        </ul>
        <h3 class="pt-4 text-2xl font-bold">New pavement, repair, or sealcoat</h3>
        <p>
          New asphalt paving is the right call when the surface has alligator cracking, when the edges have crumbled, or when you are covering a gravel driveway with asphalt for the first time. We remove what will not support a mat, compact base rock, and place hot-mix asphalt in a continuous operation so the joints stay tight. Driveway resurfacing and parking lot resurfacing follow the same prep when the base is still sound.
        </p>
        <p>
          Asphalt repair fits isolated damage. A utility cut, settled patch, or single pothole can be saw-cut and rebuilt without replacing the whole drive. Crack sealing and patching help when the surrounding pavement is still strong. If cracks map the entire surface, we price replacement instead of selling a short-lived patch.
        </p>
        <p>
          Sealcoating is maintenance for cured asphalt, not a structural fix. New pavement needs time to cure before sealer. Older pavement can be sealed after cracks are filled, oil spots are treated, and broken areas are patched. We block the surface until the coating can take tires.
        </p>
        <div class="grid gap-5 pt-4 sm:grid-cols-2">
          <Diagram name="repair" label="Saw-cut asphalt repair inside sound pavement" />
          <Diagram name="seal" label="Sealcoat over cured asphalt and compacted base" />
        </div>
        <h3 class="pt-4 text-2xl font-bold">Timing, traffic, and care</h3>
        <p>
          Hot-mix needs a dry base and temperatures that support placement and compaction. In {business.city}, workable paving conditions cover {config.market.pavingSeason}. We move a pave day rather than place a mat that cannot be compacted correctly.
        </p>
        <p>
          Passenger cars often return after the mat has cooled, commonly the next day. Trailer jacks, tight power-steering turns, and heavy trucks can scar tender asphalt, so we give you a return time for your project and that day’s weather.
        </p>
        <p>
          Parking lots need a plan for customers. When the site allows it, we phase the work and leave a path open. Private roads need a detour or a clear closure window. Both decisions are in the estimate, so nobody discovers a blocked driveway on the morning the trucks arrive.
        </p>
        <h3 class="pt-4 text-2xl font-bold">Where we work</h3>
        <p>
          The home base is {business.serviceAreaLabel}. Share the project address when you call or write so we can confirm truck access and plant delivery before quoting the job.
        </p>
        <p>
          Hours are {hours.map((row) => `${row.days} ${row.time}`).join(" · ")}. Estimators return calls during posted hours.
        </p>
        <p>
          Ready for a number you can use? Call <a class="tracking-phone font-semibold underline decoration-carbon underline-offset-4" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
          or send the form with your square footage. The visit is free. The recommendation will match the pavement you have, whether that is a driveway, a lot, a private road, a repair, or a sealcoat.
        </p>
      </div>
      <aside class="h-fit border border-carbon/10 bg-white p-6 lg:sticky lg:top-20">
        <h2 class="text-xl font-bold">Talk with an estimator</h2>
        <p class="mt-3 text-sm text-graphite">Service area: {business.serviceAreaLabel}. Local paving company for asphalt contractor work in the city limits.</p>
        <a class="tracking-phone mt-4 block bg-carbon px-4 py-3 text-center font-bold text-sun" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
        <a class="mt-3 block border border-carbon px-4 py-3 text-center font-semibold" href="/contact">Go to the contact form</a>
        <p class="mt-4 text-sm text-graphite">{hours.map((row) => `${row.days} ${row.time}`).join(" · ")}</p>
      </aside>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-3xl font-bold">Questions from local property owners</h2>
      <div class="mt-8">
        <FaqList />
      </div>
    </div>
  </section>

  <InternalLinks />
</BaseLayout>
