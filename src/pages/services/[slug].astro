---
import Diagram from "../../components/Diagram.astro";
import InternalLinks from "../../components/InternalLinks.astro";
import { business } from "../../data/site";
import { services } from "../../data/services";
import { serviceSchema } from "../../data/schema";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, business.url).href;
const extraSchemas = [serviceSchema(service, pageUrl)];
const diagram = {
  "asphalt-driveway-paving": "driveway",
  "asphalt-parking-lot": "lot",
  "asphalt-roads": "road",
  "asphalt-repair": "repair",
  "asphalt-sealcoating": "seal",
} as const;
---

<BaseLayout title={`${service.title} | ${business.name}`} description={service.description} extraSchemas={extraSchemas}>
  <article class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="text-4xl font-bold">{service.h1}</h1>
      <div class="mt-8">
        <Diagram name={diagram[service.slug]} label={service.description} loading="eager" />
      </div>
      {
        service.sections.map((section) => (
          <section class="mt-10">
            <h2 class="text-2xl font-bold">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="mt-4 text-graphite">{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="mt-4 list-disc space-y-2 pl-5">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      <div class="mt-12 border border-carbon/10 bg-linen p-6">
        <h2 class="text-2xl font-bold">Claim your free estimate</h2>
        <p class="mt-3">
          Call <a class="tracking-phone font-bold" href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a> or send the project size from the contact page for a free asphalt estimate. Quotes are free, and we confirm the scope on site as your Pocatello paving contractor.
        </p>
        <a class="mt-5 inline-block bg-sun px-5 py-3 font-bold text-carbon" href="/contact">Request a free estimate</a>
        <p class="mt-4 text-sm">
          Return to <a class="font-semibold underline decoration-sun decoration-2 underline-offset-4" href="/">Pocatello asphalt paving</a> for every service we offer.
        </p>
      </div>
    </div>
  </article>
  <InternalLinks currentService={service.slug} />
</BaseLayout>
