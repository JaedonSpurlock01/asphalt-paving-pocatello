---
import { steps } from "../data/site";
---

<ol class="grid gap-8 md:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="border-t-4 border-sun bg-white p-5">
        <p class="text-sm font-bold tracking-wide text-graphite uppercase">Step {index + 1}</p>
        <h3 class="mt-2 text-xl font-bold">{step.title}</h3>
        <p class="mt-3 text-sm leading-6 text-graphite">{step.text}</p>
      </li>
    ))
  }
</ol>
