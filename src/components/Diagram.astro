---
import { Image } from "astro:assets";
import siteAssets from "virtual:site-assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: "driveway" | "lot" | "road" | "repair" | "seal" | "process";
  label: string;
  loading?: "lazy" | "eager";
}

const { name, label, loading = "lazy" } = Astro.props;

const images: Record<Props["name"], ImageMetadata> = {
  driveway: siteAssets.driveway,
  lot: siteAssets.lot,
  road: siteAssets.road,
  repair: siteAssets.repair,
  seal: siteAssets.seal,
  process: siteAssets.process,
};

const src = images[name];
---

<figure>
  <Image
    src={src}
    alt={label}
    width={src.width}
    height={src.height}
    loading={loading}
    class="block h-auto w-full"
  />
</figure>
