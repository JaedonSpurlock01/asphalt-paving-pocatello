---
import { Image } from "astro:assets";
import logoDark from "../assets/logo-dark.png";
import logoLight from "../assets/logo-light.png";

interface Props {
  variant?: "light" | "dark";
  class?: string;
  loading?: "eager" | "lazy";
}

const { variant = "light", class: className = "h-12 w-auto", loading = "eager" } = Astro.props;
const logo = variant === "dark" ? logoDark : logoLight;
---

<Image
  src={logo}
  alt=""
  width={logo.width}
  height={logo.height}
  densities={[1, 2]}
  loading={loading}
  decoding={loading === "eager" ? "sync" : "async"}
  class={className}
/>
