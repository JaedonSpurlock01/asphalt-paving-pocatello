{
  "name": "asphalt-paving-blackfoot",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "main": "../../dist/_worker.js/index.js",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS"
  },
  "vars": {
    "LEAD_DELIVERY_EMAIL": "spurjae@gmail.com",
    "LEAD_NOTIFY_EMAIL": "spurjae@gmail.com"
  },
  "send_email": [
    {
      "name": "LEAD_EMAIL",
      "allowed_sender_addresses": [
        "info@asphaltpavingblackfoot.com"
      ],
      "allowed_destination_addresses": [
        "info@asphaltpavingblackfoot.com",
        "spurjae@gmail.com"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
